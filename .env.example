# ============================================================================
# SECURE AUTHENTICATION — ENVIRONMENT CONFIGURATION (.env)
# ============================================================================
# Rename this file to .env and fill in your actual credentials.
# Never commit real API keys, passwords, or secrets to version control.
# ============================================================================

# --- Database Credentials ---
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=secure_login

# --- Google OAuth 2.0 Credentials ---
# Obtain from Google Cloud Console (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth_callback.php

# --- Gmail SMTP Configuration ---
# Generate a Gmail App Password at: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM_EMAIL=your_gmail_address@gmail.com
MAIL_FROM_NAME=SecureAuth System
